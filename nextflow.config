// plant-virus QC pipeline — Nextflow config.
manifest {
    name            = 'plant-virus-qc'
    author          = 'Andrew Budge <andrewcbudge@gmail.com>'
    description     = 'Adapter/quality trimming and rRNA depletion for plant virus RNA-seq'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    // Samplesheet: CSV with header  sample,fastq_1,fastq_2
    input  = null

    // Root that relative paths in the samplesheet and in --sortmerna_ref /
    // --sortmerna_idx resolve against. Keeping the sheet relative and moving
    // this one flag is what lets the same samplesheet run on CHPC scratch and
    // on a laptop. Absolute paths still work and ignore this.
    data_dir = null

    // Root for reference databases and indexes. Defaults to --data_dir. Split
    // it out once the references move somewhere shared -- they outlive any one
    // project and are too big to duplicate per project.
    db_dir   = null

    outdir   = "${projectDir}/results"

    // fastp
    fastp_quality = 20        // -q / --qualified_quality_phred

    // sortmerna
    sortmerna_ref = null      // reference FASTA, e.g. smr_v4.3_default_db.fasta

    // Prebuilt index directory. When set, SORTMERNA_INDEX is skipped entirely.
    // The index is reference-only and reusable forever — build it once and
    // point every future run at it rather than paying ~14 min per project.
    sortmerna_idx = null

    sortmerna_index_mem = 4096  // sortmerna -m, MB per index part (NOT the SLURM request)
}

// per-process cpus/memory/time + retry policy
includeConfig 'conf/base.config'

profiles {
    // CHPC SLURM + apptainer. The normal way to run this.
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // Run on a single machine through apptainer — useful for testing the
    // container wiring before committing to the scheduler.
    local_apptainer {
        process.executor       = 'local'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        process.resourceLimits = [ memory: 14.GB, cpus: 4, time: 24.h ]
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.resourceLimits = [ memory: 14.GB, cpus: 4, time: 24.h ]
    }
}

// Run provenance. report.html is the thing to ask a lab member for when a run
// goes wrong — it carries exit codes, peak memory and runtime per task.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
