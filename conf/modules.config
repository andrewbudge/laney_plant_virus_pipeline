// Per-process directives: containers, publishDir, tool args.
process {
    // Keep sortmerna_image pinned at 4.3.4. 4.3.6+ and 7.0.0 are built for
    // x86-64-v3 (AVX2+BMI2+FMA) and SIGILL on lonepeak's Sandy Bridge nodes;
    // 4.3.4 is the last baseline-SSE build.
    withName: 'FASTP' {
        container = 'docker://quay.io/biocontainers/fastp:0.23.4--h125f33a_5'
        publishDir = [ path: { "${params.outdir}/fastp/${meta.id}" }, mode: 'copy' ]
        ext.args   = "--detect_adapter_for_pe -q ${params.fastp_quality}"
    }

    withName: 'SORTMERNA' {
        container = 'docker://quay.io/biocontainers/sortmerna:4.3.4--h9ee0642_0'
        publishDir = [ path: { "${params.outdir}/sortmerna/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'SPADES' {
        container = 'docker://quay.io/biocontainers/spades:4.3.0--hde4eca7_1'
        // saveAs flattens 'spades_out/<file>' to just '<file>', matching the
        // flat per-sample layout of fastp/ and sortmerna/.
        publishDir = [ path: { "${params.outdir}/spades/${meta.id}" }, mode: 'copy',
                       saveAs: { fn -> fn.replaceFirst('^spades_out/', '') } ]
        ext.args   = ''
    }

    withName: 'MULTIQC' {
        container = 'docker://quay.io/biocontainers/multiqc:1.25.2--pyhdfd78af_0'
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: 'copy' ]
    }
}
