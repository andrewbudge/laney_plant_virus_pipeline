// Per-process directives: containers, publishDir, tool args.
process {
    // Keep sortmerna_image pinned at 4.3.4. 4.3.6+ and 7.0.0 are built for
    // x86-64-v3 (AVX2+BMI2+FMA) and SIGILL on lonepeak's Sandy Bridge nodes;
    // 4.3.4 is the last baseline-SSE build.
    withName: 'FASTP' {
        container = 'docker://quay.io/biocontainers/fastp:0.23.4--h125f33a_5'
        publishDir = [ path: { "${params.outdir}/01_fastp/${meta.id}" }, mode: 'copy' ]
        ext.args   = "--detect_adapter_for_pe -q ${params.fastp_quality}"
    }

    withName: 'SORTMERNA' {
        container = 'docker://quay.io/biocontainers/sortmerna:4.3.4--h9ee0642_0'
        publishDir = [ path: { "${params.outdir}/02_sortmerna/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'SPADES' {
        // 4.2+ SIGILL on lonepeak's pre-AVX2 Xeons; 4.0.0 is compatible and
        // supports --rnaviral.
        container = 'docker://quay.io/biocontainers/spades:4.0.0--haf24da9_4'
        // saveAs flattens 'spades_out/<file>' to just '<file>', matching the
        // flat per-sample layout of 01_fastp/ and 02_sortmerna/.
        publishDir = [ path: { "${params.outdir}/03_spades/${meta.id}" }, mode: 'copy',
                       saveAs: { fn -> fn.replaceFirst('^spades_out/', '') } ]
    }

    withName: 'FILTER' {
        container = 'docker://quay.io/biocontainers/seqkit:2.13.0--he881be0_0'
        publishDir = [ path: { "${params.outdir}/04_filter/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'MULTIQC' {
        container = 'docker://quay.io/biocontainers/multiqc:1.25.2--pyhdfd78af_0'
        publishDir = [ path: { "${params.outdir}/08_multiqc" }, mode: 'copy' ]
    }

    withName: 'GENOMAD' {
        // geNomad 1.12.0 bundles mmseqs2 >=15.6f452 and tensorflow >=2.16,
        // both SIMD-sensitive: SIGILL risk on lonepeak's Sandy Bridge (AVX-only)
        // nodes. geNomad GitHub issues #158/#165 document mmseqs2 createdb
        // SIGILL on old CPUs. Verify with a real subset run before production;
        // a newer partition may be needed.
        container = 'docker://quay.io/biocontainers/genomad:1.12.0--pyhdfd78af_0'
        publishDir = [ path: { "${params.outdir}/05_genomad/${meta.id}" }, mode: 'copy',
                       saveAs: { fn ->
                           def prefix = "${meta.id}_genomad/${meta.id}_summary/"
                           fn.startsWith(prefix) ? fn.substring(prefix.length()) : fn
                       } ]
    }

    withName: 'BOWTIE2' {
        // Bowtie2 is SSE-era code and is AVX-safe. Only logs are published:
        // the SAM is handed to SAMTOOLS_SORT and 18M-pair SAMs are huge.
        container = 'docker://quay.io/biocontainers/bowtie2:2.5.5--ha27dd3b_0'
        publishDir = [ path: { "${params.outdir}/06_bowtie2/${meta.id}" }, mode: 'copy', pattern: '*.log' ]
    }

    withName: 'SAMTOOLS_SORT' {
        container = 'docker://quay.io/biocontainers/samtools:1.24--h9dcdb79_1'
        publishDir = [ path: { "${params.outdir}/06_bowtie2/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'DIAMOND_RVDB' {
        // Diamond 2.1.8 is AVX-safe on notchpeak-guest (AVX-512).
        container = 'docker://quay.io/biocontainers/diamond:2.1.8--h43eeafb_0'
        publishDir = [ path: { "${params.outdir}/07_diamond/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'DIAMOND_UNIREF90' {
        // UniRef90 = unbiased viral confirmation leg.
        container = 'docker://quay.io/biocontainers/diamond:2.1.8--h43eeafb_0'
        publishDir = [ path: { "${params.outdir}/07_diamond/${meta.id}" }, mode: 'copy' ]
    }

    withName: 'EVIDENCE' {
        container = 'docker://ubuntu:24.04'
        publishDir = [ path: { "${params.outdir}/evidence" }, mode: 'copy' ]
    }

    withName: 'BLASTN_VIROID' {
        container = 'docker://quay.io/biocontainers/blast:2.17.0--hb02a186_1'
        publishDir = [ path: { "${params.outdir}/09_viroid/${meta.id}" }, mode: 'copy' ]
    }
}
