# Container images
*.sif
*.img

# Data never belongs in the repo: reads, references and indexes live under
# --data_dir / --db_dir on whatever machine is running.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fasta
*.fa
*.fna
*.faa

# OS / editor
.DS_Store
*.swp
*~
